PORT=4000
# Where the Astro site runs (CORS)
CLIENT_ORIGIN=http://localhost:4321
# Secret for admin (write) endpoints. Generate: openssl rand -hex 32
ADMIN_TOKEN=change-me

# Optional: Vercel deploy hook; pinged after art changes so the static site rebuilds
DEPLOY_HOOK_URL=
# Optional: CDN / custom domain in front of the public bucket (default: the Neon bucket URL)
STORAGE_PUBLIC_URL=

# Database + storage come from Neon. Run `neon deploy` (or `neon env pull`) in the
# project root; it writes DATABASE_URL, DATABASE_URL_UNPOOLED, AWS_ENDPOINT_URL_S3,
# AWS_REGION, AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY to ../.env.local, which
# the npm scripts load automatically. In production, set those same variables on your host.
