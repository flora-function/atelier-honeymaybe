---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allArt = await getCollection('art');
const sorted = allArt.sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<BaseLayout title="archive" description="The full archive of honeymaybe's art">
  <div class="max-w-5xl mx-auto px-6 pt-12 pb-16">

    <!-- Header -->
    <div class="mb-10">
      <div class="inline-block border-3 border-bark bg-sky px-4 py-2 shadow-pixel mb-4">
        <h1 class="font-pixel text-xs text-bark">the archive</h1>
      </div>
      <p class="font-display text-2xl text-bark/70 mt-2">
        everything i have ever made, more or less. ({sorted.length} piece{sorted.length !== 1 ? 's' : ''})
      </p>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-5">
      {sorted.map(piece => (
        <a
          href={`/archive/${piece.id}`}
          class="pixel-card block overflow-hidden group"
        >
          <div class="bg-lavender/20 aspect-square overflow-hidden">
            <img
              src={piece.data.image}
              alt={piece.data.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              style="image-rendering: auto;"
              onerror="this.style.display='none'; this.parentElement.classList.add('flex','items-center','justify-center'); this.parentElement.innerHTML='<span class=\'font-display text-3xl text-bark/20\'>no img</span>'"
            />
          </div>
          <div class="p-3 border-t-3 border-bark">
            <p class="font-pixel text-xs leading-relaxed truncate">{piece.data.title}</p>
            <p class="font-display text-base text-bark/60 mt-1">{piece.data.medium}</p>
          </div>
        </a>
      ))}
    </div>

  </div>
  <script>
    const SIZE = 32;
    const colors = ['#fdf6e3','#f5e6c0','#f4c542','#b8a0d6','#7ab8d4','#5a8a3c','#e85d4a','#ffb3c6'];

    const canvas = document.createElement('canvas');
    canvas.setAttribute('aria-hidden', 'true');
    Object.assign(canvas.style, {
      position: 'fixed', inset: '0', zIndex: '99999', pointerEvents: 'none',
      imageRendering: 'pixelated',
    });

    const W = canvas.width  = window.innerWidth;
    const H = canvas.height = window.innerHeight;
    document.body.appendChild(canvas);

    const ctx = canvas.getContext('2d')!;
    const cols = Math.ceil(W / SIZE);
    const rows = Math.ceil(H / SIZE);

    // draw each square a random palette colour
    const cells: [number, number][] = [];
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        ctx.fillStyle = colors[Math.floor(Math.random() * colors.length)];
        ctx.fillRect(c * SIZE, r * SIZE, SIZE, SIZE);
        cells.push([c, r]);
      }
    }

    // shuffle
    for (let i = cells.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [cells[i], cells[j]] = [cells[j], cells[i]];
    }

    const BATCH = 40; // squares cleared per frame
    let idx = 0;

    function erase() {
      for (let i = 0; i < BATCH && idx < cells.length; i++, idx++) {
        const [c, r] = cells[idx];
        ctx.clearRect(c * SIZE, r * SIZE, SIZE, SIZE);
      }
      if (idx < cells.length) {
        requestAnimationFrame(erase);
      } else {
        canvas.remove();
      }
    }

    // slight delay so page is ready
    setTimeout(() => requestAnimationFrame(erase), 200);
  </script>
</BaseLayout>
