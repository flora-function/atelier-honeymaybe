---
// Scattered pixel art sprites — fixed, behind content, in the margins
// Each pixel = 4px on a grid
---

<div class="sprites-layer" aria-hidden="true">

  <!-- Mushroom top-right -->
  <div class="sprite" style="top: 130px; right: 24px; transform: rotate(8deg);">
    <svg width="40" height="40" xmlns="http://www.w3.org/2000/svg">
      <!-- cap -->
      <rect x="8"  y="0"  width="24" height="4"  fill="#e85d4a"/>
      <rect x="4"  y="4"  width="32" height="4"  fill="#e85d4a"/>
      <rect x="0"  y="8"  width="40" height="4"  fill="#e85d4a"/>
      <rect x="0"  y="12" width="40" height="4"  fill="#e85d4a"/>
      <rect x="0"  y="16" width="40" height="4"  fill="#e85d4a"/>
      <!-- spots -->
      <rect x="4"  y="8"  width="8"  height="8"  fill="#fdf6e3"/>
      <rect x="24" y="4"  width="8"  height="8"  fill="#fdf6e3"/>
      <rect x="20" y="14" width="6"  height="4"  fill="#fdf6e3"/>
      <!-- underside -->
      <rect x="4"  y="20" width="32" height="4"  fill="#fdf6e3"/>
      <!-- stem -->
      <rect x="12" y="24" width="16" height="4"  fill="#f4c542"/>
      <rect x="10" y="28" width="20" height="4"  fill="#f4c542"/>
      <rect x="10" y="32" width="20" height="4"  fill="#f4c542"/>
    </svg>
  </div>

  <!-- Star left, below header -->
  <div class="sprite" style="top: 280px; left: 18px; transform: rotate(-12deg);">
    <svg width="28" height="28" xmlns="http://www.w3.org/2000/svg">
      <rect x="8"  y="0"  width="4"  height="8"  fill="#f4c542"/><!-- top -->
      <rect x="0"  y="8"  width="8"  height="4"  fill="#f4c542"/><!-- left -->
      <rect x="8"  y="8"  width="4"  height="4"  fill="#f4c542"/><!-- centre -->
      <rect x="16" y="8"  width="8"  height="4"  fill="#f4c542"/><!-- right -->
      <rect x="8"  y="16" width="4"  height="8"  fill="#f4c542"/><!-- bottom -->
      <!-- diagonals (lighter) -->
      <rect x="4"  y="4"  width="4"  height="4"  fill="#f4c54280"/>
      <rect x="16" y="4"  width="4"  height="4"  fill="#f4c54280"/>
      <rect x="4"  y="16" width="4"  height="4"  fill="#f4c54280"/>
      <rect x="16" y="16" width="4"  height="4"  fill="#f4c54280"/>
    </svg>
  </div>

  <!-- Bee, right side -->
  <div class="sprite" style="top: 420px; right: 30px; transform: rotate(-15deg);">
    <svg width="36" height="32" xmlns="http://www.w3.org/2000/svg">
      <!-- antennae -->
      <rect x="8"  y="0"  width="4"  height="4"  fill="#2d1b00"/>
      <rect x="24" y="0"  width="4"  height="4"  fill="#2d1b00"/>
      <rect x="12" y="4"  width="4"  height="4"  fill="#2d1b00"/>
      <rect x="20" y="4"  width="4"  height="4"  fill="#2d1b00"/>
      <!-- wings -->
      <rect x="0"  y="8"  width="12" height="12" fill="#c7e9f1" opacity="0.9"/>
      <rect x="24" y="8"  width="12" height="12" fill="#c7e9f1" opacity="0.9"/>
      <!-- head -->
      <rect x="12" y="8"  width="12" height="4"  fill="#f4c542"/>
      <!-- stripes -->
      <rect x="12" y="12" width="12" height="4"  fill="#2d1b00"/>
      <rect x="12" y="16" width="12" height="4"  fill="#f4c542"/>
      <rect x="12" y="20" width="12" height="4"  fill="#2d1b00"/>
      <!-- stinger -->
      <rect x="14" y="24" width="8"  height="4"  fill="#2d1b00"/>
    </svg>
  </div>

  <!-- Pink flower, left side -->
  <div class="sprite" style="top: 580px; left: 22px; transform: rotate(10deg);">
    <svg width="28" height="28" xmlns="http://www.w3.org/2000/svg">
      <!-- petals (cross + diagonals) -->
      <rect x="8"  y="0"  width="8"  height="8"  fill="#ffb3c6"/>
      <rect x="0"  y="8"  width="8"  height="8"  fill="#ffb3c6"/>
      <rect x="16" y="8"  width="8"  height="8"  fill="#ffb3c6"/>
      <rect x="8"  y="16" width="8"  height="8"  fill="#ffb3c6"/>
      <rect x="4"  y="4"  width="4"  height="4"  fill="#ffb3c6"/>
      <rect x="16" y="4"  width="4"  height="4"  fill="#ffb3c6"/>
      <rect x="4"  y="16" width="4"  height="4"  fill="#ffb3c6"/>
      <rect x="16" y="16" width="4"  height="4"  fill="#ffb3c6"/>
      <!-- centre -->
      <rect x="8"  y="8"  width="8"  height="8"  fill="#f4c542"/>
    </svg>
  </div>

  <!-- Lavender star, right side lower -->
  <div class="sprite" style="top: 700px; right: 18px; transform: rotate(20deg);">
    <svg width="28" height="28" xmlns="http://www.w3.org/2000/svg">
      <rect x="8"  y="0"  width="4"  height="8"  fill="#b8a0d6"/>
      <rect x="0"  y="8"  width="8"  height="4"  fill="#b8a0d6"/>
      <rect x="8"  y="8"  width="4"  height="4"  fill="#b8a0d6"/>
      <rect x="16" y="8"  width="8"  height="4"  fill="#b8a0d6"/>
      <rect x="8"  y="16" width="4"  height="8"  fill="#b8a0d6"/>
      <rect x="4"  y="4"  width="4"  height="4"  fill="#b8a0d680"/>
      <rect x="16" y="4"  width="4"  height="4"  fill="#b8a0d680"/>
      <rect x="4"  y="16" width="4"  height="4"  fill="#b8a0d680"/>
      <rect x="16" y="16" width="4"  height="4"  fill="#b8a0d680"/>
    </svg>
  </div>

  <!-- Small mushroom, left lower -->
  <div class="sprite" style="top: 860px; left: 16px; transform: rotate(-6deg); opacity: 0.6;">
    <svg width="28" height="28" xmlns="http://www.w3.org/2000/svg">
      <rect x="6"  y="0"  width="16" height="4"  fill="#7ab8d4"/>
      <rect x="2"  y="4"  width="24" height="4"  fill="#7ab8d4"/>
      <rect x="0"  y="8"  width="28" height="4"  fill="#7ab8d4"/>
      <rect x="0"  y="12" width="28" height="4"  fill="#7ab8d4"/>
      <rect x="4"  y="8"  width="6"  height="6"  fill="#fdf6e3"/>
      <rect x="18" y="4"  width="4"  height="4"  fill="#fdf6e3"/>
      <rect x="2"  y="16" width="24" height="4"  fill="#fdf6e3"/>
      <rect x="8"  y="20" width="12" height="4"  fill="#f4c542"/>
      <rect x="8"  y="24" width="12" height="4"  fill="#f4c542"/>
    </svg>
  </div>

  <!-- Blue spiral 1, left side upper -->
  <div class="sprite" style="top: 190px; left: 20px; transform: rotate(-5deg);">
    <svg width="32" height="28" xmlns="http://www.w3.org/2000/svg">
      <rect x="8"  y="0"  width="16" height="4"  fill="#7ab8d4"/>
      <rect x="4"  y="4"  width="4"  height="4"  fill="#7ab8d4"/>
      <rect x="20" y="4"  width="4"  height="4"  fill="#7ab8d4"/>
      <rect x="0"  y="8"  width="4"  height="4"  fill="#7ab8d4"/>
      <rect x="8"  y="8"  width="8"  height="4"  fill="#7ab8d4"/>
      <rect x="20" y="8"  width="4"  height="4"  fill="#7ab8d4"/>
      <rect x="0"  y="12" width="4"  height="4"  fill="#7ab8d4"/>
      <rect x="8"  y="12" width="4"  height="4"  fill="#7ab8d4"/>
      <rect x="20" y="12" width="4"  height="4"  fill="#7ab8d4"/>
      <rect x="0"  y="16" width="4"  height="4"  fill="#7ab8d4"/>
      <rect x="8"  y="16" width="16" height="4"  fill="#7ab8d4"/>
      <rect x="0"  y="20" width="4"  height="4"  fill="#7ab8d4"/>
      <rect x="4"  y="24" width="20" height="4"  fill="#7ab8d4"/>
    </svg>
  </div>

  <!-- Blue spiral 2, right side mid — slightly larger, lighter -->
  <div class="sprite" style="top: 520px; right: 22px; transform: rotate(18deg); opacity: 0.55;">
    <svg width="40" height="36" xmlns="http://www.w3.org/2000/svg">
      <rect x="8"  y="0"  width="24" height="4"  fill="#c7e9f1"/>
      <rect x="4"  y="4"  width="4"  height="4"  fill="#c7e9f1"/>
      <rect x="28" y="4"  width="4"  height="4"  fill="#c7e9f1"/>
      <rect x="0"  y="8"  width="4"  height="4"  fill="#c7e9f1"/>
      <rect x="12" y="8"  width="8"  height="4"  fill="#c7e9f1"/>
      <rect x="28" y="8"  width="4"  height="4"  fill="#c7e9f1"/>
      <rect x="0"  y="12" width="4"  height="4"  fill="#c7e9f1"/>
      <rect x="12" y="12" width="4"  height="4"  fill="#c7e9f1"/>
      <rect x="28" y="12" width="4"  height="4"  fill="#c7e9f1"/>
      <rect x="0"  y="16" width="4"  height="4"  fill="#c7e9f1"/>
      <rect x="12" y="16" width="20" height="4"  fill="#c7e9f1"/>
      <rect x="0"  y="20" width="4"  height="4"  fill="#c7e9f1"/>
      <rect x="4"  y="24" width="28" height="4"  fill="#c7e9f1"/>
    </svg>
  </div>

  <!-- Blue spiral 3, left lower — small, darker -->
  <div class="sprite" style="top: 760px; left: 14px; transform: rotate(-22deg);">
    <svg width="24" height="20" xmlns="http://www.w3.org/2000/svg">
      <rect x="4"  y="0"  width="12" height="4"  fill="#5a9ab5"/>
      <rect x="0"  y="4"  width="4"  height="4"  fill="#5a9ab5"/>
      <rect x="16" y="4"  width="4"  height="4"  fill="#5a9ab5"/>
      <rect x="0"  y="8"  width="4"  height="4"  fill="#5a9ab5"/>
      <rect x="8"  y="8"  width="4"  height="4"  fill="#5a9ab5"/>
      <rect x="16" y="8"  width="4"  height="4"  fill="#5a9ab5"/>
      <rect x="0"  y="12" width="4"  height="4"  fill="#5a9ab5"/>
      <rect x="4"  y="16" width="16" height="4"  fill="#5a9ab5"/>
    </svg>
  </div>

  <!-- Coral star near footer area -->
  <div class="sprite" style="bottom: 140px; right: 28px; transform: rotate(-8deg);">
    <svg width="24" height="24" xmlns="http://www.w3.org/2000/svg">
      <rect x="8"  y="0"  width="4"  height="8"  fill="#e85d4a"/>
      <rect x="0"  y="8"  width="8"  height="4"  fill="#e85d4a"/>
      <rect x="8"  y="8"  width="4"  height="4"  fill="#e85d4a"/>
      <rect x="12" y="8"  width="8"  height="4"  fill="#e85d4a"/>
      <rect x="8"  y="12" width="4"  height="8"  fill="#e85d4a"/>
    </svg>
  </div>

</div>

<style>
  .sprites-layer {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    overflow: hidden;
  }
  .sprite {
    position: absolute;
    opacity: 0.65;
    image-rendering: pixelated;
  }
</style>
